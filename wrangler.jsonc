{
  "name": "portfolio",
  "compatibility_date": "2026-08-31",
  "assets": {
    // Quartz builds into ./public. Pages are emitted as foo.html and served at /foo.
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "rootbeer.sh",
      "custom_domain": true
    }
  ]
}
